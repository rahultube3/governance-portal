{
  "name": "ap193004-fb-governance-portal-experience",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": "apps/ap193004-fb-governance-portal-experience",
  "sourceRoot": "apps/ap193004-fb-governance-portal-experience/src",
  "prefix": "gp",
  "tags": [
    "type:web",
    "domain:governance"
  ],
  "metadata": {
    "appInfo": {
      "appVersion": "1.0.0",
      "appType": "ichip",
      "appId": "ap193004",
      "domain": "fb-governance",
      "appName": "fb-governance-portal-experience"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath.base}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/fb-governance/fb-governance-portal-experience",
          "browser": ""
        },
        "browser": "apps/ap193004-fb-governance-portal-experience/src/main.ts",
        "tsConfig": "apps/ap193004-fb-governance-portal-experience/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/ap193004-fb-governance-portal-experience/public"
          }
        ],
        "styles": [
          "apps/ap193004-fb-governance-portal-experience/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "dependsOn": [
        {
          "projects": [
            "ap193007-fb-governance-portal-experience-api"
          ],
          "target": "serve"
        }
      ],
      "options": {
        "port": 4200,
        "proxyConfig": "apps/ap193004-fb-governance-portal-experience/proxy.conf.json"
      },
      "configurations": {
        "development": {
          "buildTarget": "ap193004-fb-governance-portal-experience-web:build:development"
        },
        "production": {
          "buildTarget": "ap193004-fb-governance-portal-experience-web:build:production"
        }
      }
    }
  }
}
